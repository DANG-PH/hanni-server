# ===================================================================
#  HANNI SERVER — BIẾN MÔI TRƯỜNG
#  Copy file này thành `.env` rồi điền giá trị. `.env` KHÔNG commit.
#  App sẽ dừng khi khởi động nếu thiếu biến bắt buộc (xem src/config/env.validation.ts).
# ===================================================================

# ---------- Ứng dụng ----------
NODE_ENV=development
PORT=8000
API_PREFIX=/api
# URL công khai của backend — dùng để dựng redirect_uri của Google OAuth
APP_URL=http://localhost:8000
# URL frontend — dùng cho CORS và redirect sau khi đăng nhập Google
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug                      # trace | debug | info | warn | error

# ---------- PostgreSQL (Prisma) ----------
# Cú pháp: postgresql://<user>:<mật_khẩu>@<host>:<port>/<db>?schema=public
#  - Docker compose kèm repo map Postgres ra cổng 2222 (xem docker-compose.yml):
#      postgresql://hanni:hanni@localhost:2222/hanni?schema=public
#  - Dịch vụ hosted (Neon / Supabase / RDS): dán chuỗi họ cấp, thêm ?schema=public.
#    Nếu đi qua PgBouncer: thêm &pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://hanni:hanni@localhost:2222/hanni?schema=public
# (tùy chọn) shadow DB cho `prisma migrate` khi DB chính không cho tạo DB tạm
# SHADOW_DATABASE_URL=postgresql://hanni:hanni@localhost:2222/hanni_shadow?schema=public

# ---------- Redis ----------
# Dùng cho: lưu state OAuth (TTL ngắn), cache, (sau) hàng đợi BullMQ.
#  - Docker compose kèm repo map Redis ra cổng 2223:
#      redis://localhost:2223/0
#  - Có mật khẩu: redis://:<mật_khẩu>@<host>:6379/0
#  - Upstash / TLS: dùng scheme rediss://
REDIS_URL=redis://localhost:2223/0

# ---------- JWT / phiên đăng nhập ----------
# Access token sống ngắn (nằm trong cookie HttpOnly `hanni_access`).
# Refresh token xoay vòng, chỉ lưu HASH trong DB (cookie `hanni_refresh`).
# Sinh secret mạnh:  openssl rand -base64 48
JWT_ACCESS_SECRET=doi_gia_tri_nay_bang_chuoi_ngau_nhien_>=16_ky_tu
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=doi_gia_tri_nay_bang_chuoi_ngau_nhien_khac_>=16
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost              # prod: domain thật, vd .hanni.app
COOKIE_SECURE=false                  # prod: true (bắt buộc HTTPS)

# ---------- Google (đăng nhập bằng id_token) ----------
# Luồng: frontend lấy id_token qua Google Identity Services → gửi POST /api/auth/google
#        → backend verify chữ ký + `aud` bằng google-auth-library. KHÔNG cần client secret.
# CÁCH LẤY:
#  1. https://console.cloud.google.com → tạo Project.
#  2. "APIs & Services" → "OAuth consent screen": User type External, điền tên app + email.
#  3. "Credentials" → "Create Credentials" → "OAuth client ID":
#       - Application type: Web application
#       - Authorized JavaScript origins:  http://localhost:3000   (+ domain prod sau này)
#       - (không cần Authorized redirect URIs cho luồng này)
#  4. Copy Client ID vào đây. Client secret Google có cấp kèm nhưng KHÔNG dùng.
# Client ID này cũng cần đặt ở hanni-client/.env.local -> NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com                  # giây — TTL của state OAuth lưu trong Redis

# ---------- Gửi mail (xác minh email + reset mật khẩu + email tổng kết tuần) ----------
# Để trống MAIL_HOST → MailService chỉ in nội dung mail ra console (production: quên mật khẩu KHÔNG gửi được).
# Miễn phí bằng Gmail: bật xác minh 2 bước → https://myaccount.google.com/apppasswords → tạo "Mật khẩu ứng dụng"
# 16 ký tự → MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=<gmail>, MAIL_PASSWORD=<mật khẩu ứng dụng>,
# MAIL_FROM="Hanni <gmail đó>" (Gmail đổi người gửi về đúng tài khoản đăng nhập).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Hanni <no-reply@hanni.app>"

# ---------- Spaced repetition ----------
SRS_SCHEDULER=sm2                    # sm2 | fsrs  (mặc định khi tạo user mới)
SRS_DEFAULT_NEW_PER_DAY=10           # số từ mới / ngày (user chỉnh được sau)
SRS_DEFAULT_TARGET_RETENTION=0.9     # chỉ dùng cho FSRS

# ---------- Streak / ngày học ----------
DEFAULT_USER_TIMEZONE=Asia/Ho_Chi_Minh   # timezone mặc định khi tạo user (tên IANA)
STREAK_DAY_CUTOFF_HOUR=3                  # giờ địa phương mà "ngày học" chuyển ngày mới

# ---------- Rate limit ----------
THROTTLE_TTL=60                      # giây
THROTTLE_LIMIT=100                   # request / TTL / IP (route auth siết chặt riêng trong code)

# ---------- Audio phát âm ----------
AUDIO_BASE_URL=                      # chưa tích hợp TTS; audio_url của từ sẽ trỏ vào đây khi có

# ---------- Học qua video: dịch phụ đề (MIỄN PHÍ, không cần key) ----------
# Bản chép tiếng Trung lấy từ CC track của YouTube; bản dịch tiếng Việt do
# MyMemory (free) dịch máy + bảng thuật ngữ tu tiên. Điền email để nâng hạn
# mức ngày (~1k → 50k từ). Bỏ trống dùng địa chỉ giả nội bộ.
MYMEMORY_EMAIL=

# ---------- Thông báo đẩy (Web Push, MIỄN PHÍ, không cần dịch vụ ngoài) ----------
# Sinh 1 lần bằng: npx web-push generate-vapid-keys
# Bỏ trống thì tính năng thông báo tự tắt (API trả lỗi rõ ràng, không crash app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hanni.app   # liên hệ khi nhà mạng cần báo lỗi push

# ---------- Seed ----------
SEED_RESET=false                    # true = xoá sạch bảng Word trước khi seed lại

# ---------- AI (Gemini) — trợ lý, luyện nói, quét ảnh, mẹo nhớ, Hanni Coach ----------
# Lấy key: https://aistudio.google.com/apikey → "Create API key". Gói miễn phí ~20 lượt/ngày CHO MỖI model
# (dùng chung cho mọi tính năng AI + mọi lần thử local) → bán Premium thì phải bật billing (trả theo lượt dùng).
# Bỏ trống thì mọi tính năng AI tự báo "chưa bật", app vẫn chạy.
GEMINI_API_KEY=
AI_SYSTEM_PROMPT=                   # tuỳ chọn — thay lời dặn hệ thống mặc định của trợ lý (assistant.service.ts)

# ---------- Thanh toán Premium (payOS — miễn phí, cá nhân đăng ký bằng CCCD) ----------
# 1. https://my.payos.vn → đăng ký → xác thực "Cá nhân/Hộ kinh doanh" bằng CCCD → liên kết tài khoản ngân hàng
#    (phải TRÙNG TÊN chủ CCCD) → tạo "Kênh thanh toán".
# 2. Trong kênh thanh toán: copy Client ID, API Key, Checksum Key vào 3 dòng dưới.
# 3. Khai Webhook URL của kênh: https://hanni-api.dangpham.id.vn/api/payments/webhook/payos (payOS gửi thử 1 lần,
#    server trả 200 là được nhận).
# Checksum Key dùng để xác thực webhook — lộ ra là người khác tự cấp Premium cho mình được → KHÔNG commit, không
# dán vào chat. Bỏ trống 3 dòng thì nút mua Premium hiện "Sắp mở bán" (GET /api/payments/configured → false).
# payOS KHÔNG có sandbox: thử bằng giao dịch thật số tiền nhỏ (tiền về chính tài khoản của bạn).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---------- Thanh toán qua cổng MoMo (ví MoMo / thẻ ATM / thẻ quốc tế) — tuỳ chọn ----------
# Bỏ trống thì popup Premium chỉ có payOS (QR payOS vẫn quét được bằng app MoMo). MOMO_API_URL mặc định là SANDBOX
# (tiền ảo): khoá sandbox công khai trong code mẫu của MoMo (github.com/momo-wallet/payment): partnerCode MOMO,
# accessKey F8BBA842ECF85, secretKey K951B6PE1waDMi640xX08PD3vg6EkVlz; thẻ ATM thử: 9704 0000 0000 0018, NGUYEN VAN A,
# 03/07, OTP. Trên production đơn sandbox chạy trọn luồng nhưng KHÔNG cộng Premium thật (ai cũng có thẻ thử).
# Khoá thật: đăng ký business.momo.vn (hồ sơ doanh nghiệp, hợp đồng, UAT) → MOMO_API_URL=https://payment.momo.vn.
# MoMo gọi IPN về APP_URL + API_PREFIX + /payments/webhook/momo → APP_URL phải là địa chỉ công khai của API.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn

# Biến nào trong file này cũng khai ở src/config/env.validation.ts (zod) — biến tuỳ chọn có giá trị mặc định nên
# thiếu cũng không crash, chỉ TẮT tính năng đó. PRODUCTION đọc file .env trên VPS (thư mục app, vd
# /root/hanni-server/.env), KHÔNG đọc file nào trên máy bạn — sửa xong chạy: pm2 restart hanni-server --update-env
