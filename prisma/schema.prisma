// Hanni — lược đồ dữ liệu (PostgreSQL).
// Xem hanni-server/CLAUDE.md và tài liệu plan để biết lý do thiết kế.
// Nhóm bảng: Auth/User · Từ vựng · Spaced Repetition · Tiến độ · Động lực (gamification).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
//  ENUM
// ===================================================================

enum AuthProvider {
  GOOGLE
  // chừa: FACEBOOK, APPLE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// 5 kỹ năng HSK 3.0: 听 说 读 写 译
enum SkillType {
  LISTENING
  SPEAKING
  READING
  WRITING
  TRANSLATION
}

enum HskBand {
  ELEMENTARY // HSK 1-3
  INTERMEDIATE // HSK 4-6
  ADVANCED // HSK 7-9 (thi chung)
}

enum WordPos {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  NUMERAL
  MEASURE
  CONJUNCTION
  PREPOSITION
  PARTICLE
  INTERJECTION
  IDIOM
  PHRASE
  OTHER
}

/// Trạng thái bản dịch tiếng Việt của 1 từ.
enum TranslationStatus {
  MISSING // chưa có nghĩa tiếng Việt
  MACHINE // dịch máy (CVDICT), chưa review
  REVIEWED // người đã rà soát
  HUMAN // người biên dịch từ đầu
}

/// Trạng thái ghi nhớ của 1 thẻ theo từng user (SM-2 / FSRS dùng chung).
enum SrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// 4 nút đánh giá khi ôn (map sang chất lượng nhớ tùy thuật toán).
enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ReviewType {
  LEARN
  REVIEW
  RELEARN
  CRAM
  QUIZ
}

enum GoalType {
  WORDS
  MINUTES
}

enum AchievementCategory {
  STREAK
  LEVEL
  VOLUME
  ACCURACY
  MILESTONE
}

enum StudySource {
  REVIEW
  LEARN
  QUIZ
}

enum VideoKind {
  PODCAST
  STORY
  SONG
  DIALOGUE
  CLIP
  OTHER
}

// ===================================================================
//  NHÓM AUTH / USER
// ===================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime?
  /// null nếu user chỉ đăng nhập bằng Google
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  /// Tên timezone IANA (vd "Asia/Ho_Chi_Minh") — KHÔNG lưu offset, để xử lý đúng DST.
  timezone        String    @default("Asia/Ho_Chi_Minh")
  locale          String    @default("vi")
  role            String    @default("user") // user | admin | translator
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastActiveAt    DateTime?

  accounts          Account[]
  refreshTokens     RefreshToken[]
  settings          UserSettings?
  wordProgress      UserWordProgress[]
  reviewLogs        ReviewLog[]
  studySessions     StudySession[]
  dailyActivity     UserDailyActivity[]
  streak            UserStreak?
  achievements      UserAchievement[]
  levelProgress     UserLevelProgress[]
  lessonProgress    UserLessonProgress[]
  quizAttempts      QuizAttempt[]
  videos            Video[]
  videoProgress     UserVideoProgress[]
  examAttempts      ExamAttempt[]
  pushSubscriptions PushSubscription[]

  @@index([lastActiveAt])
}

/// Danh tính OAuth (kiểu Auth.js). Mỗi provider + tài khoản ngoài = 1 dòng.
model Account {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String // vd Google `sub`
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  idToken           String?
  tokenType         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Refresh token của Hanni — xoay vòng, chỉ lưu HASH. Phát hiện reuse theo familyId.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Token xác minh email + reset mật khẩu. Chỉ lưu HASH.
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  identifier String // email
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([identifier])
}

/// Cài đặt học của user (1-1 User).
model UserSettings {
  userId           String   @id @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGoalType    GoalType @default(WORDS)
  dailyGoalValue   Int      @default(20)
  newCardsPerDay   Int      @default(10)
  maxReviewsPerDay Int?
  srsScheduler     String   @default("sm2") // sm2 | fsrs
  targetRetention  Float    @default(0.9) // chỉ dùng cho FSRS
  reminderHour     Int? // 0-23, giờ địa phương (cho push sau)
  updatedAt        DateTime @updatedAt
}

// ===================================================================
//  NHÓM TỪ VỰNG
// ===================================================================

/// Bảng tra tĩnh 9 cấp HSK. Lưu CẢ chỉ tiêu bản 2021 và bản 2025 để app đối chiếu.
model HskLevel {
  level          Int         @id // 1..9
  band           HskBand
  isSharedBand   Boolean     @default(false) // true cho 7,8,9 (thi chung)
  nameVi         String
  newWords2021   Int
  cumulative2021 Int
  newWords2025   Int
  cumulative2025 Int
  readingChars   Int?
  writingChars   Int?
  skills         SkillType[]

  words         Word[]
  lessons       Lesson[]
  levelProgress UserLevelProgress[]
}

/// Bài học — chia nhỏ từ vựng mỗi cấp HSK thành lộ trình tuyến tính (~15 từ/bài),
/// sắp theo tần suất. Seed tĩnh từ words.seed.json.
model Lesson {
  id         String   @id @default(uuid()) @db.Uuid
  hskLevel   Int
  level      HskLevel @relation(fields: [hskLevel], references: [level])
  orderIndex Int // 1..N trong cấp
  title      String // vd "Bài 1"
  wordCount  Int      @default(0)

  words          Word[]
  lessonProgress UserLessonProgress[]

  @@unique([hskLevel, orderIndex])
  @@index([hskLevel])
}

model Word {
  id                String            @id @default(uuid()) @db.Uuid
  simplified        String
  traditional       String?
  /// pinyin có dấu thanh (vd "nǐ hǎo")
  pinyin            String
  /// pinyin dạng số (vd "ni3 hao3") — khóa join dataset + tìm kiếm không dấu
  pinyinNumeric     String
  hskLevel          Int
  level             HskLevel          @relation(fields: [hskLevel], references: [level])
  /// true khi nguồn chỉ phân loại "7-9" chứ không tách 7/8/9
  hskBandOnly       Boolean           @default(false)
  pos               WordPos[]
  frequencyRank     Int?
  radical           String?
  strokeCount       Int?
  meaningVi         String?
  meaningEn         String?
  translationStatus TranslationStatus @default(MISSING)
  needsReview       Boolean           @default(true)
  audioUrl          String? // /media/audio/cmn-<hán tự>.mp3 (phục vụ tĩnh)
  /// provenance: nguồn gốc dữ liệu
  source            String?
  /// bài học chứa từ này (lộ trình tuyến tính theo cấp)
  lessonId          String?           @db.Uuid
  lesson            Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonOrder       Int? // thứ tự trong bài
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  examples WordExample[]
  progress UserWordProgress[]

  @@unique([simplified, pinyinNumeric])
  @@index([hskLevel, frequencyRank]) // chọn thứ tự học từ mới
  @@index([lessonId, lessonOrder])
  @@index([needsReview])
}

model WordExample {
  id         String  @id @default(uuid()) @db.Uuid
  wordId     String  @db.Uuid
  word       Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  zh         String
  pinyin     String?
  vi         String?
  en         String?
  audioUrl   String?
  orderIndex Int     @default(0)
  source     String?

  @@index([wordId])
}

// ===================================================================
//  NHÓM SPACED REPETITION
// ===================================================================

/// Trạng thái SRS: 1 dòng / (user, word). Chứa superset trường của SM-2 và FSRS
/// để đổi thuật toán không cần migration.
model UserWordProgress {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId   String   @db.Uuid
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  /// denormalize từ Word.hskLevel — để lọc "chỉ ôn HSK 2" không cần join.
  hskLevel Int
  state    SrsState @default(NEW)

  // --- dùng chung ---
  dueAt          DateTime?
  lastReviewedAt DateTime?
  reps           Int           @default(0)
  lapses         Int           @default(0)
  lastRating     ReviewRating?
  learnedAt      DateTime? // mốc "đã thuộc" lần đầu
  isSuspended    Boolean       @default(false)
  isLeech        Boolean       @default(false)

  // --- SM-2 ---
  easeFactor   Float @default(2.5)
  intervalDays Float @default(0)

  // --- FSRS ---
  stability  Float?
  difficulty Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewLogs ReviewLog[]

  @@unique([userId, wordId])
  @@index([userId, dueAt]) // truy vấn "đến hạn" — quan trọng nhất
  @@index([userId, hskLevel, dueAt]) // queue theo cấp
  @@index([userId, state]) // đếm dashboard, chọn thẻ mới
}

/// Lịch sử review — append-only. Cần cho FSRS optimize + phân tích + streak.
model ReviewLog {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId         String           @db.Uuid
  progressId     String           @db.Uuid
  progress       UserWordProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  studySessionId String?          @db.Uuid
  studySession   StudySession?    @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  rating     ReviewRating
  reviewType ReviewType
  reviewedAt DateTime     @default(now())

  stateBefore      SrsState
  stateAfter       SrsState
  intervalBefore   Float
  intervalAfter    Float
  easeBefore       Float?
  easeAfter        Float?
  stabilityBefore  Float?
  stabilityAfter   Float?
  difficultyBefore Float?
  difficultyAfter  Float?
  elapsedDays      Float    @default(0)
  scheduledDays    Float    @default(0)
  durationMs       Int?

  @@index([userId, reviewedAt])
  @@index([wordId])
  @@index([progressId])
}

model StudySession {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        StudySource
  startedAt     DateTime    @default(now())
  endedAt       DateTime?
  cardsReviewed Int         @default(0)
  cardsCorrect  Int         @default(0)
  newCards      Int         @default(0)

  reviewLogs   ReviewLog[]
  quizAttempts QuizAttempt[]

  @@index([userId, startedAt])
}

// ===================================================================
//  NHÓM TIẾN ĐỘ
// ===================================================================

/// Cache đọc O(1) cho dashboard — cập nhật tăng dần sau mỗi review.
model UserLevelProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hskLevel       Int
  level          HskLevel  @relation(fields: [hskLevel], references: [level])
  totalWords     Int       @default(0)
  learnedWords   Int       @default(0)
  reviewingWords Int       @default(0)
  dueWords       Int       @default(0)
  atRiskWords    Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, hskLevel])
}

/// Tiến độ theo từng Bài của user (dùng cho trang Lộ trình).
model UserLessonProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String    @db.Uuid
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  learnedWords Int       @default(0)
  totalWords   Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

// ===================================================================
//  NHÓM ĐỘNG LỰC (GAMIFICATION)
// ===================================================================

/// 1 dòng / (user, ngày-địa-phương). Nền cho streak, mục tiêu ngày, biểu đồ.
model UserDailyActivity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ngày theo timezone của user (chỉ phần date)
  localDate      DateTime @db.Date
  wordsReviewed  Int      @default(0)
  wordsLearned   Int      @default(0)
  minutesStudied Float    @default(0)
  goalMet        Boolean  @default(false)
  xp             Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, localDate])
  @@index([userId, localDate(sort: Desc)])
}

/// Denormalize chuỗi streak để đọc nhanh (1-1 User).
model UserStreak {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActiveLocalDate DateTime? @db.Date
  streakFreezeCount   Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

/// Danh mục huy hiệu (seed tĩnh).
model Achievement {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique // HSK1_COMPLETE, STREAK_7, ...
  nameVi        String
  descriptionVi String
  iconUrl       String?
  category      AchievementCategory
  threshold     Int                 @default(0)
  meta          Json?

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  progressValue Int         @default(0)

  @@unique([userId, achievementId])
  @@index([userId])
}

model QuizAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessionId String?       @db.Uuid
  studySession   StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  totalQuestions Int           @default(0)
  correctCount   Int           @default(0)
  scorePct       Float         @default(0)
  format         Json?

  answers QuizAnswer[]

  @@index([userId, completedAt])
}

model QuizAnswer {
  id            String      @id @default(uuid()) @db.Uuid
  quizAttemptId String      @db.Uuid
  quizAttempt   QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  wordId        String      @db.Uuid
  isCorrect     Boolean
  chosen        String?
  correct       String?
  responseMs    Int?

  @@index([quizAttemptId])
}

// ===================================================================
//  NHÓM HỌC QUA VIDEO
// ===================================================================

/// Video YouTube kèm bản chép (transcript) + bản dịch tiếng Việt.
model Video {
  id            String    @id @default(uuid()) @db.Uuid
  youtubeId     String
  title         String // tiêu đề tiếng Việt
  titleZh       String?
  description   String?
  hskLevel      Int?
  kind          VideoKind @default(PODCAST)
  sentenceCount Int       @default(0)
  thumbnailUrl  String?
  author        String? // tên kênh YouTube
  isFree        Boolean   @default(true)
  sortOrder     Int       @default(1000) // nhỏ hiện trước; video hệ thống được xếp tay
  createdById   String?   @db.Uuid
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines    VideoLine[]
  progress UserVideoProgress[]

  @@index([hskLevel])
  @@index([sortOrder, createdAt])
}

/// Một câu trong bản chép của video.
model VideoLine {
  id        String  @id @default(uuid()) @db.Uuid
  videoId   String  @db.Uuid
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  index     Int // 1-based
  startMs   Int? // mốc thời gian trong video (nếu có)
  zh        String
  pinyin    String // âm tiết cách nhau bằng khoảng trắng (dấu thanh)
  pinyinNum String  @default("") // pinyin số — để tô màu theo thanh điệu
  vi        String?

  @@unique([videoId, index])
  @@index([videoId])
}

/// Tiến độ xem video của từng user.
model UserVideoProgress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId       String    @db.Uuid
  video         Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lastLineIndex Int       @default(0)
  linesRead     Int       @default(0)
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

// ===================================================================
//  NGỮ PHÁP (nội dung tĩnh, seed sẵn)
// ===================================================================

/// Một điểm ngữ pháp HSK. Nội dung do Hanni soạn (dataset từ vựng không có).
model GrammarPoint {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  hskLevel      Int
  orderIndex    Int      @default(0)
  titleVi       String // "Trợ từ 了 — hành động hoàn thành"
  titleZh       String // "了"
  summaryVi     String // 1–2 câu tóm tắt
  explanationVi String // giải thích đầy đủ (xuống dòng bằng \n)
  patterns      String[] // ["Chủ ngữ + Động từ + 了", ...]
  examples      Json // [{ zh, pinyin, vi }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hskLevel, orderIndex])
}

// ===================================================================
//  KIỂM TRA HSK
// ===================================================================

/// Kết quả một lần làm bài Kiểm tra HSK (quiz sinh từ từ vựng theo cấp).
model ExamAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hskLevel     Int
  totalCount   Int
  correctCount Int
  durationSec  Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ===================================================================
//  THÔNG BÁO ĐẨY (Web Push)
// ===================================================================

/// Đăng ký nhận thông báo đẩy của 1 thiết bị/trình duyệt. 1 user có thể có
/// nhiều thiết bị (điện thoại, máy tính…) → nhiều dòng.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
